# ─── CORE ─────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Đổi model khi model mặc định quá tải (lỗi 503 high demand) — thay tên model trong URL
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent

# ─── AUTH (tuỳ chọn) ─────────────
# Để trống thì đăng nhập Google bị tắt; JWT_SECRET nên đổi khi deploy
GOOGLE_OAUTH_CLIENT_ID=
APP_SWAGGER_ENABLED=false
# JWT_SECRET=chuoi-bi-mat-dai-it-nhat-64-ky-tu

# ─── VIDEO SERVICE (tuỳ chọn) ─────────────
# mock | google | elevenlabs
# TTS_PROVIDER=mock
# Backend tự gửi lecture sang video-service và poll trạng thái render.
APP_VIDEO_ENABLED=true
VIDEO_PUBLIC_BASE_URL=http://localhost:3001
APP_VIDEO_POLL_INTERVAL_MS=15000
# ELEVENLABS_API_KEY=
# UPLOAD_TO_SUPABASE=true
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET_NAME=lecture-videos

# Vietnamese narration. Use mock only for fully offline/silent development.
TTS_PROVIDER=google

# Self-hosted animated 3D teacher (no paid API key required).
AVATAR_PROVIDER=sadtalker
AUTO_START_LOCAL_SADTALKER=true
# Docker keeps the lightweight service available, while start_all.ps1 selects
# SadTalker from the local venv. The video service deliberately rejects this
# fallback as a talking clip and shows a still teaching pose instead.
AVATAR_ENGINE=fallback
# The bundled Docker avatar image is fallback-only. Set true only when the
# avatar container/image actually includes a ready SadTalker installation.
REQUIRE_LIP_SYNCED_AVATAR=false
SADTALKER_EXPRESSION_SCALE=1.0
SADTALKER_POSE_STYLE=0
SADTALKER_MAX_SOURCE_SIZE=512
SADTALKER_ENHANCER=
MAX_CONCURRENT_AVATARS=1

# Optional: AI illustrations for video slides. Without a key (or when the
# provider rejects the request), video rendering uses a built-in visual.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux

# Set to "veo" to render full-screen 3D animated scenes like an AI story video.
# Veo uses GEMINI_API_KEY and may incur API charges; "none" keeps slide mode.
SCENE_VIDEO_PROVIDER=none
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_TIMEOUT_MS=420000
VEO_POLL_INTERVAL_MS=10000

# ─── RESILIENCE & PERFORMANCE ─────────────
# Maximum simultaneous Remotion video rendering jobs on EC2
MAX_CONCURRENT_RENDERS=1

# Maximum minutes a job can remain in PROCESSING before being marked FAILED
JOB_TIMEOUT_MINUTES=120

# OCR for scanned/image-only PDF uploads
APP_DOCUMENT_OCR_ENABLED=true
APP_DOCUMENT_OCR_MAX_PAGES=30
APP_DOCUMENT_OCR_DPI=200
APP_DOCUMENT_OCR_LANGUAGES=vie+eng
APP_DOCUMENT_MAX_EXTRACTED_CHARACTERS=60000

# ─── DEPLOYMENT (EC2) ─────────────
# Set these when deploying to EC2. Replace <EC2_PUBLIC_IP> with your instance's IP.
# VITE_API_BASE_URL=http://<EC2_PUBLIC_IP>:8081/api
# APP_CORS_ALLOWED_ORIGINS=http://<EC2_PUBLIC_IP>,http://<EC2_PUBLIC_IP>:80

# ─── EMAIL (tuỳ chọn) — Gmail SMTP, dùng App Password chứ không phải mật khẩu Gmail ─────
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ─── SECRETS NỘI BỘ (nên đổi khi deploy) ─────────────
# INTERNAL_EVENTS_TOKEN=
# LIVE_WEBHOOK_SECRET=change-me-in-production

# ─── THANH TOÁN SEPAY ─────────────
# Tài khoản ngân hàng đã liên kết với SePay. BANK_NAME dùng short_name/alias trong banks.json.
# Secret phải trùng với HMAC-SHA256 Secret Key khi tạo webhook trên my.sepay.vn.
# KHÔNG commit số tài khoản/secret thật vào git.
# SEPAY_BANK_ACCOUNT=
# SEPAY_BANK_NAME=Vietcombank
# Chỉ đặt riêng dòng dưới nếu QR dùng virtual account (VA).
# SEPAY_WEBHOOK_ACCOUNT_NUMBER=
# SEPAY_ACCOUNT_HOLDER=
# SEPAY_WEBHOOK_SECRET=
# Cấu hình cấu trúc mã tương ứng trên SePay: tiền tố DH, hậu tố đúng 8 chữ số.
# SEPAY_PAYMENT_CODE_PREFIX=DH
# Tự động hủy giao dịch vẫn PENDING sau số phút này; tác vụ quét chạy mỗi 60 giây.
# SEPAY_PENDING_EXPIRATION_MINUTES=15
# SEPAY_PENDING_EXPIRATION_SWEEP_MS=60000

# ─── BẢO MẬT KHI DEPLOY (FIX #12) ─────────────
# Mặc định false để chạy local ngay. Khi deploy THẬT, đặt =true VÀ cấp JWT_SECRET,
# LIVE_WEBHOOK_SECRET và SEPAY_WEBHOOK_SECRET thật ở trên — app sẽ từ chối khởi động nếu thiếu.
# APP_ENFORCE_SECRETS=true

# Gói còn hiệu lực bắt buộc cho AI/render của giáo viên và nội dung/làm bài của học sinh.
APP_SUBSCRIPTIONS_ENFORCE_PREMIUM=true

# Tạo webhook SePay dạng JSON, sự kiện "Có tiền vào", xác thực HMAC-SHA256:
# https://your-domain/api/payments/webhook/sepay
# VIDEO_SERVICE_INTERNAL_URL=http://localhost:3001 # local; Docker dùng http://video-service:3001
