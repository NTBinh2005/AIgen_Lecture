PORT=3001
TTS_PROVIDER=google

# Set to mock only when developing without network access.
# TTS_PROVIDER=mock

# ElevenLabs TTS (chỉ dùng khi có gói trả phí)
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your-api-key-here

# Optional AI illustrations. Leave empty to use the built-in visual fallback.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux

# Optional cinematic mode: one full-screen 3D animated clip per teaching scene.
# Uses the same GEMINI_API_KEY as the backend. Keep "none" for the current
# slide + teacher layout; set to "veo" for a Veo 3.1 result.
SCENE_VIDEO_PROVIDER=none
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_TIMEOUT_MS=420000
VEO_POLL_INTERVAL_MS=10000

# ─── 3D Avatar Video Provider ────────────────────────────────────────────────
# Mặc định dùng service Python self-hosted (không cần API trả phí).
# Các giá trị hỗ trợ: mock | heygen | d-id | sadtalker
AVATAR_PROVIDER=sadtalker
SADTALKER_API_URL=http://localhost:5000/api/talk
VIDEO_SERVICE_INTERNAL_URL=http://localhost:3001
REQUIRE_LIP_SYNCED_AVATAR=true
# SadTalker can take more than five minutes per slide on CPU/smaller GPUs.
AVATAR_GENERATION_TIMEOUT_MS=1200000

# Cấu hình HeyGen API (nếu AVATAR_PROVIDER=heygen)
HEYGEN_API_KEY=your-heygen-api-key
HEYGEN_AVATAR_ID=Daisy-innocent-20220818

# Cấu hình D-ID API (nếu AVATAR_PROVIDER=d-id)
DID_API_KEY=your-d-id-api-key
AVATAR_IMAGE_URL=https://example.com/avatar3d.jpg

# ─── Supabase Storage (lưu video lên cloud sau khi render) ───────────
UPLOAD_TO_SUPABASE=false
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
SUPABASE_BUCKET_NAME=lecture-videos
